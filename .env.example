# Copy to .env (never commit .env). All optional: without keys the agent runs in offline demo mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Retrieval
EMBEDDER=hashing            # hashing (offline) | openai
OPENAI_API_KEY=             # only if EMBEDDER=openai
STORE=memory                # memory | pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendas
TOP_K=4
# MIN_SIMILARITY=0.12       # defaults: 0.12 hashing, 0.30 openai

# Tracing (optional, set BEFORE starting the app)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
